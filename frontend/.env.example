VITE_API_BASE_URL=http://localhost:8000/api
# Dev servers: leave VITE_API_BASE_URL empty to use same-origin /api and let the
# Vite dev proxy (see vite.config.ts) forward requests to the backend.
# VITE_API_BASE_URL=
# Google OAuth flow used by the "Sign in with Google" buttons:
#   implicit    — returns an access token, works without GOOGLE_CLIENT_SECRET
#   auth-code   — returns an authorization code the backend exchanges
#                 (requires GOOGLE_CLIENT_SECRET on the backend)
# VITE_GOOGLE_OAUTH_FLOW=implicit
VITE_GITHUB_OAUTH_URL=http://localhost:8000/api/auth/github/
VITE_GOOGLE_CLIENT_ID=27042928964-pbolsldqvdv2hfipblmrcf332evg83v8.apps.googleusercontent.com
# Explicit demo login button (never used as silent OAuth fallback).
# true/false; if unset, enabled only in Vite DEV mode.
# VITE_ALLOW_DEMO_LOGIN=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
PROMETHEUS_PORT=9090


# Web Push API configuration
VITE_VAPID_PUBLIC_KEY=

# Sentry (optional) - leave blank to disable
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
